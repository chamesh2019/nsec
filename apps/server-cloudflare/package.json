{
  "name": "@nsec/server-cloudflare",
  "version": "0.1.2",
  "description": "NullSec Zero-Knowledge Server for Cloudflare Workers with D1 Database",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create nullsec-db",
    "db:init:local": "wrangler d1 execute nullsec-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute nullsec-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@nsec/core": "workspace:*",
    "@nsec/crypto": "workspace:*",
    "@nsec/server": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.84.0"
  }
}
