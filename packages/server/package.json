{
  "name": "@chamesh2020/server",
  "version": "0.1.0",
  "description": "Zero-knowledge REST API server for zvault",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zvault-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@chamesh2020/core": "workspace:*",
    "@chamesh2020/crypto": "workspace:*",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
