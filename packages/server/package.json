{
  "name": "@nsec/server",
  "version": "0.2.0",
  "description": "Zero-knowledge REST API and Web Dashboard server for NullSec / ZVault",

  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nsec-server": "./dist/index.js",
    "nullsec-server": "./dist/index.js",
    "zvault-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@nsec/core": "workspace:*",
    "@nsec/crypto": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}

